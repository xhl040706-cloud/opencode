{
  "$schema": "https://costrict.ai/cloud-config-schema.json",
  "_comment": "Cloud mode configuration for cs serve - controls remote file access permissions",
  "_comment_platform": "Default blacklist is platform-specific. See documentation for details.",
  
  "allowAbsolutePaths": true,
  "maxListDepth": 3,
  "allowedOperations": ["list", "read", "search"],
  
  "_default_blacklist_comment": "By default, the following paths are blocked based on your platform:",
  "_default_blacklist_linux": [
    "All /etc/**, /bin/**, /sbin/**, /lib/**, /usr/** system directories",
    "/root/**, /var/**, /proc/**, /sys/**, /dev/**",
    "**/.ssh/**, **/.aws/**, **/.kube/**, **/.docker/**",
    "**/.bash_history, **/.zsh_history",
    "**/*.key, **/*.pem, **/.env*",
    "**/node_modules/**, **/.git/**"
  ],
  "_default_blacklist_macos": [
    "/System/**, /Library/**, /private/**",
    "**/Library/Keychains/**, **/Library/Cookies/**",
    "**/.bash_history, **/.zsh_history",
    "**/.ssh/**, **/.aws/**, **/.kube/**",
    "**/*.key, **/*.pem, **/.env*",
    "**/node_modules/**, **/.git/**"
  ],
  "_default_blacklist_windows": [
    "C:/Windows/**, C:/Program Files/**, C:/ProgramData/**",
    "**/AppData/Roaming/Microsoft/**, **/NTUSER.DAT*",
    "**/.ssh/**, **/.aws/**, **/.kube/**",
    "**/*.key, **/*.pem, **/.env*",
    "**/node_modules/**, **/.git/**"
  ],
  
  "_custom_blacklist_comment": "Add your custom blacklist entries here (in addition to defaults):",
  "pathBlacklist": [
    "/custom/sensitive/path/**",
    "**/*.secret"
  ],
  
  "_pathWhitelist_comment": "If specified, ONLY these paths are allowed (overrides blacklist):",
  "_pathWhitelist_example": [
    "/home/user/projects/**",
    "/workspace/**",
    "/data/shared/**"
  ]
}
